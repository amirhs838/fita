# ─────────────────────────────────────────────────────────────
# Fita — environment template (copy to .env and fill in)
# On Liara: set these in App → Settings → Environment tab
# ─────────────────────────────────────────────────────────────

# SQLite database (Prisma)
# Local:            file:./db/custom.db
# Liara (disk at /app/data):  file:/app/data/custom.db   ← ABSOLUTE path, survives redeploys
DATABASE_URL="file:./db/custom.db"

# User session signing (generate: openssl rand -hex 32)
JWT_SECRET=change-me-64-char-random-hex

# Admin panel (/admin) — owner password (NEVER commit the real value)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-64-char-random-hex

# AI provider (openrouter | zai | mock)
# OpenRouter key can also be set at runtime from the admin panel (stored in DB).
# On Liara pick the Germany region — openrouter.ai is not reachable from Iranian IPs.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=minimax/minimax-m3:free
OPENROUTER_VISION_MODEL=minimax/minimax-m3:free

# Payment (mock = simulated gateway; zarinpal needs a real merchant id)
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
