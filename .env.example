# Fita — environment template (copy to .env and fill in)

# SQLite database (Prisma)
DATABASE_URL="file:./db/custom.db"

# User session
SESSION_TTL_DAYS=7

# OTP (dev = code shown in response/log; sms = plug-in point in src/lib/otp.ts)
OTP_PROVIDER=dev
OTP_TTL_SECONDS=120

# Admin panel (/admin) — owner password
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=random-long-string

# AI provider (openrouter | zai | mock) — key can also be set from the admin panel
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Subscription
FREE_TRIAL_DAYS=3
FREE_SCAN_LIMIT=5

# Payment (mock = simulated gateway)
PAYMENT_PROVIDER=mock
